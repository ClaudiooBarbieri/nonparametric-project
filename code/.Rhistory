# Create the plot
ggplot(datam, aes(x = BDsample_0, y = LC_0, fill = LC_0)) +
geom_jitter(aes(color = LC_0), size = 0.5, alpha = 0.6,
position = position_nudge(y = -0.2)) +  # Jittered points
geom_boxplot(width = 0.15, alpha = 0.8, outlier.shape = NA, color = "black", position = position_nudge(y = -0.2)) + # Boxplot with higher opacity
geom_density_ridges(alpha = 0.6, scale = 1, rel_min_height = 0.01) +           # Density ridges
labs(x = "Bulk density (g cm⁻³)", y = "", fill = "Land Cover") +
theme_minimal() +
scale_fill_manual(values = colors[c(2,3,5)])              # Boxplot fill colors
